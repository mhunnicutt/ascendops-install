{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch"
    ],
    "defaultMode": "bypassPermissions"
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$CTX_FRAMEWORK_ROOT/dist/cli.js\" bus hook-context-status",
    "refreshInterval": 5,
    "timeout": 2
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CTX_FRAMEWORK_ROOT/dist/cli.js\" bus hook-planmode-telegram",
            "timeout": 1860
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CTX_FRAMEWORK_ROOT/dist/cli.js\" bus hook-permission-telegram",
            "timeout": 1860
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CTX_FRAMEWORK_ROOT/dist/cli.js\" bus hook-loop-detector",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CTX_FRAMEWORK_ROOT/dist/cli.js\" bus hook-ask-telegram",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CTX_FRAMEWORK_ROOT/dist/cli.js\" bus hook-idle-flag",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CTX_FRAMEWORK_ROOT/dist/cli.js\" crash-alert",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CTX_FRAMEWORK_ROOT/dist/cli.js\" bus hook-compact-telegram",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": true,
    "caveman@caveman": true
  }
}
